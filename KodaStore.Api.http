@url = http://localhost:5188

GET {{url}}/weatherforecast/
Accept: application/json

### GET ALL PRODUCTS
GET {{url}}/api/v1/products
Accept: application/json

### GET ALL CUSTOMERS
GET {{url}}/api/v1/customers
Accept: application/json

### GET PRODUCT DETAILS
GET {{url}}/api/v1/products/PR001
Accept: application/json

### GET CUSTOMER DETAILS
GET {{url}}/api/v1/customers/1
Accept: application/json

### CREATE CUSTOMER
POST {{url}}/api/v1/customers
Accept: application/json
Content-Type: application/json

{
    "name": "Andi",
    "email": "andi@gmail.com",
    "phone": "08123456789",
    "address": "Solo"
}
### CREATE ANOTHER CUSTOMER
POST {{url}}/api/v1/customers
Accept: application/json
Content-Type: application/json

{
    "name": "Budi",
    "email": "budi@gmail.com",
    "phone": "08123787124",
    "address": "Semarang"
}

### CREATE PRODUCT
POST {{url}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "customerId": 1,
    "productCode": "PR001",
    "name": "Keyboard",
    "price": 30000,
    "stock": 15,
    "category": "Elektronik"
}
### CREATE ANOTHER PRODUCT
POST {{url}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "customerId": 1,
    "productCode": "PR003",
    "name": "Monitor",
    "price": 1400000,
    "stock": 4,
    "category": "Elektronik"
}

### YET CREATE ANOTHER PRODUCT
POST {{url}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "customerId": 14,
    "productCode": "PR002",
    "name": "Mouse",
    "price": 25000,
    "stock": 20,
    "category": "Elektronik"
}

### AND YET AGAIN CREATE PRODUCT
POST {{url}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "customerId": 2147483647,
    "productCode": "PR-NO-CUSTOMER",
    "name": "Invalid customer test",
    "price": 1000,
    "stock": 1,
    "category": "Test"
}

### Upload Gambar
POST {{url}}/api/v1/products/PR001/image
Content-Type: multipart/form-data; boundary=KodaStore

--KodaStore
Content-Disposition: form-data; name="file"; filename="background.jpg"
Content-Type: image/jpeg

< "C:\Users\Flone\Pictures\background.jpg"
--KodaStore--


### DELETE PRODUCT BY CODE
DELETE {{url}}/api/v1/products/PR003
Accept: application/json

### DELETE CUSTOMER BY ID
DELETE {{url}}/api/v1/customers/1
Accept: application/json

### UPDATE PRODUCT
PUT {{url}}/api/v1/products/PR001
Accept: application/json
Content-Type: application/json

{
    "customerId": 1,
    "name": "Mouse",
    "price": 25000,
    "stock": 20,
    "category": "Aksesoris"
}

### UPDATE CUSTOMER
PUT {{url}}/api/v1/customers/2
Accept: application/json
Content-Type: application/json

{
    "name": "Budi",
    "email": "budi@gmail.com",
    "phone": "08145678902",
    "address": "Demak"
}